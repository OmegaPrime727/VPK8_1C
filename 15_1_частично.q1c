<?xml version="1.0" encoding="UTF-8"?>
<querylist>
	<query name="ЗаказыПокупателейССайта">
		<text>ВЫБРАТЬ
	ЗаказыПокупателейССайта.ЗаказПокупателя КАК ЗаказПокупателя,
	ЗаказыПокупателейССайта.УзелОбмена.ВалютаДляПодстановкиВЗаказы КАК УзелОбменаВалютаДляПодстановкиВЗаказы,
	СпрНоменклатура.Наименование КАК Наименование,
	ЦеныНоменклатуры.Цена КАК Цена
ИЗ
	РегистрСведений.ЗаказыПокупателейССайта КАК ЗаказыПокупателейССайта,
	РегистрСведений.ЦеныНоменклатуры КАК ЦеныНоменклатуры
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура
		ПО (ЦеныНоменклатуры.Номенклатура = ЦеныНоменклатуры.Номенклатура.Ссылка)  
ГДЕ
	ЗаказыПокупателейССайта.ЗаказПокупателя
</text>
		<textSQL>

		</textSQL>
		<planSQL>

		</planSQL>
		<typeSQL>

		</typeSQL>
		<parameters>
			<parameter name="КонкретныйЗаказ" type="DocumentRef.ЗаказПокупателя" value="69d17b25-021f-11ef-865d-f44efc0d0ab3"/>
		</parameters>
	</query>
</querylist>